# ==============================================================================
# PulseAI Clinical Triage & Patient Intelligence Copilot (.env)
# 100% Free-Tier Cloud Architecture
# ==============================================================================

# 1. Google Gemini AI Studio (Free Tier: 15 RPM / 1M TPM)
# Obtain your free key from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...your-google-ai-studio-api-key

# 2. Supabase PostgreSQL & pgvector (Free Tier: 500MB Database)
# Obtain your project URL and service role / anon key from: https://supabase.com/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-supabase-key

# 3. Backend Gateway Configuration (FastAPI)
PORT=8000
ENVIRONMENT=development

# 4. Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
